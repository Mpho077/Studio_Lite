<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_studio_lite" model="ir.module.category">
        <field name="name">Studio Lite</field>
        <field name="sequence">100</field>
    </record>

    <record id="res_groups_privilege_studio_lite" model="res.groups.privilege">
        <field name="name">Studio Lite</field>
        <field name="category_id" ref="module_category_studio_lite"/>
        <field name="sequence">100</field>
    </record>

    <record id="group_studio_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_studio_lite"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_studio_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_studio_lite"/>
        <field name="implied_ids" eval="[Command.link(ref('group_studio_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>
</odoo>
